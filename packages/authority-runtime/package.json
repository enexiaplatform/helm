{
  "name": "@helm/authority-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HELM Decision Authority Graph: role occupancy, versioned authority policies, consequence-based authority evaluation, delegation, approval acts, governance state and decision visibility.",
  "exports": {
    ".": "./src/index.ts",
    "./postgres": "./src/postgres.ts",
    "./conformance": "./src/conformance.ts"
  },
  "helm": {
    "layer": "kernel",
    "pure": false,
    "ioBoundary": "src/postgres.ts"
  },
  "dependencies": {
    "@helm/shared": "0.1.0",
    "@helm/ontology": "0.1.0",
    "@helm/graph-store": "0.1.0",
    "@helm/value-graph": "0.1.0",
    "@helm/propagation-engine": "0.1.0",
    "@helm/scenario-runtime": "0.1.0",
    "@helm/decision-runtime": "0.1.0"
  }
}
