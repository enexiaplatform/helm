{
  "name": "helm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "node --test \"test/unit/*.test.mjs\" \"packages/*/test/*.test.mjs\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/unit/*.test.mjs\" \"packages/*/test/*.test.mjs\"",
    "verify:architecture": "node scripts/verify-architecture.mjs",
    "verify:schema": "node scripts/verify-schema.mjs",
    "verify:ontology": "node scripts/verify-ontology.mjs",
    "verify:graph": "node scripts/verify-graph.mjs",
    "verify:memoire-boundary": "node scripts/verify-memoire-boundary.mjs",
    "verify": "npm run verify:architecture && npm run verify:schema && npm run verify:ontology && npm run verify:graph && npm run verify:memoire-boundary",
    "check": "npm run typecheck && npm run lint && npm run test && npm run verify"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.3",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.14.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^6.30.3",
    "zustand": "^4.5.7",
    "@helm/shared": "0.1.0",
    "@helm/ontology": "0.1.0",
    "@helm/graph-store": "0.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  },
  "workspaces": [
    "packages/*"
  ]
}
