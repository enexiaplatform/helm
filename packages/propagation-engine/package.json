{
  "name": "@helm/propagation-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HELM Value Propagation Engine: calculation registry, dependency graph, deterministic execution, traces and explanation.",
  "exports": {
    ".": "./src/index.ts",
    "./postgres": "./src/postgres.ts",
    "./conformance": "./src/conformance.ts"
  },
  "helm": {
    "layer": "kernel",
    "pure": false,
    "ioBoundary": "src/postgres.ts"
  },
  "dependencies": {
    "@helm/shared": "0.1.0",
    "@helm/ontology": "0.1.0",
    "@helm/graph-store": "0.1.0",
    "@helm/value-graph": "0.1.0"
  }
}
