{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "esnext",
    "types": [
      "vite/client"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@helm/shared": [
        "./packages/shared/src/index.ts"
      ],
      "@helm/ontology": [
        "./packages/ontology/src/index.ts"
      ],
      "@helm/graph-store": [
        "./packages/graph-store/src/index.ts"
      ],
      "@helm/graph-store/postgres": [
        "./packages/graph-store/src/postgres.ts"
      ],
      "@helm/graph-store/conformance": [
        "./packages/graph-store/src/conformance.ts"
      ]
    }
  },
  "include": [
    "src",
    "packages/*/src",
    "server"
  ]
}
