{
  "name": "@helm/graph-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The GraphStore port plus in-memory and Postgres adapters, and the shared conformance suite.",
  "exports": {
    ".": "./src/index.ts",
    "./conformance": "./src/conformance.ts",
    "./postgres": "./src/postgres.ts"
  },
  "helm": {
    "layer": "kernel",
    "pure": false,
    "ioBoundary": "src/postgres.ts"
  },
  "dependencies": {
    "@helm/shared": "0.1.0",
    "@helm/ontology": "0.1.0"
  }
}
