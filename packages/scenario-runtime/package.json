{
  "name": "@helm/scenario-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HELM Scenario Runtime: branching future states over the propagation engine — scenarios, revisions, overrides, fork points, replay, rebase, comparison and feasibility.",
  "exports": {
    ".": "./src/index.ts",
    "./postgres": "./src/postgres.ts",
    "./conformance": "./src/conformance.ts"
  },
  "helm": {
    "layer": "kernel",
    "pure": false,
    "ioBoundary": "src/postgres.ts"
  },
  "dependencies": {
    "@helm/shared": "0.1.0",
    "@helm/ontology": "0.1.0",
    "@helm/graph-store": "0.1.0",
    "@helm/value-graph": "0.1.0",
    "@helm/propagation-engine": "0.1.0"
  }
}
