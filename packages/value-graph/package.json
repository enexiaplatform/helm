{
  "name": "@helm/value-graph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HELM Enterprise Value Graph: metrics, value nodes, typed value links, and typed observations. Represents value structure; computes nothing.",
  "exports": {
    ".": "./src/index.ts",
    "./conformance": "./src/conformance.ts",
    "./postgres": "./src/postgres.ts"
  },
  "helm": {
    "layer": "kernel",
    "pure": false,
    "ioBoundary": "src/postgres.ts"
  },
  "dependencies": {
    "@helm/shared": "0.1.0",
    "@helm/ontology": "0.1.0",
    "@helm/graph-store": "0.1.0"
  }
}
