{
  "name": "helm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "node --test \"test/unit/*.test.mjs\" \"packages/*/test/*.test.mjs\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/unit/*.test.mjs\" \"packages/*/test/*.test.mjs\"",
    "verify:architecture": "node scripts/verify-architecture.mjs",
    "verify:schema": "node scripts/verify-schema.mjs",
    "verify:ontology": "node scripts/verify-ontology.mjs",
    "verify:graph": "node scripts/verify-graph.mjs",
    "verify:memoire-boundary": "node scripts/verify-memoire-boundary.mjs",
    "verify": "npm run verify:architecture && npm run verify:schema && npm run verify:ontology && npm run verify:graph && npm run verify:memoire-boundary && npm run verify:value-schema && npm run verify:value-metrics && npm run verify:value-graph && npm run verify:value-observations && npm run verify:calculations && npm run verify:calculation-graph && npm run verify:propagation && npm run verify:lineage && npm run verify:scenario-schema && npm run verify:scenario-runtime && npm run verify:scenario-isolation && npm run verify:scenario-time && npm run verify:scenario-lineage && npm run verify:phase-boundary && npm run verify:docs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run verify",
    "verify:value-schema": "node scripts/verify-value-schema.mjs",
    "verify:value-metrics": "node scripts/verify-value-metrics.mjs",
    "verify:value-graph": "node scripts/verify-value-graph.mjs",
    "verify:value-observations": "node scripts/verify-value-observations.mjs",
    "verify:calculations": "node scripts/verify-calculations.mjs",
    "verify:calculation-graph": "node scripts/verify-calculation-graph.mjs",
    "verify:propagation": "node scripts/verify-propagation.mjs",
    "verify:lineage": "node scripts/verify-lineage.mjs",
    "verify:phase-boundary": "node scripts/verify-phase-boundary.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "generate:calculation-governance": "node scripts/generate-calculation-governance.mjs",
    "verify:scenario-schema": "node scripts/verify-scenario-schema.mjs",
    "verify:scenario-runtime": "node scripts/verify-scenario-runtime.mjs",
    "verify:scenario-isolation": "node scripts/verify-scenario-isolation.mjs",
    "verify:scenario-time": "node scripts/verify-scenario-time.mjs",
    "verify:scenario-lineage": "node scripts/verify-scenario-lineage.mjs",
    "generate:value-metric-sync": "node scripts/generate-value-metric-sync.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.3",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.14.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^6.30.3",
    "zustand": "^4.5.7",
    "@helm/shared": "0.1.0",
    "@helm/ontology": "0.1.0",
    "@helm/graph-store": "0.1.0",
    "@helm/value-graph": "0.1.0",
    "@helm/propagation-engine": "0.1.0",
    "@helm/scenario-runtime": "0.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  },
  "workspaces": [
    "packages/*"
  ]
}
